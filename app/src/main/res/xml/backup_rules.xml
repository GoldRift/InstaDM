<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Session bearer cookies are never backed up. Debug copies are adb-pushed. -->
    <exclude domain="external" path="cookies.json" />
    <!-- Cached DM content is rebuilt from Instagram and stays on-device. -->
    <exclude domain="database" path="instadm.db" />
    <exclude domain="database" path="instadm.db-wal" />
    <exclude domain="database" path="instadm.db-shm" />
    <!-- Pending outbound attachments may contain unshared content. -->
    <exclude domain="file" path="outbox/" />
</full-backup-content>
